# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# ── Meta webhooks ─────────────────────────────────────────────────────────────
# Instagram app secret (Meta App Dashboard → App settings → Basic, or the
# Instagram product settings). Used to verify the X-Hub-Signature-256 header on
# Instagram webhook POSTs. 32 hex characters.
# (The legacy name META_APP_SECRET is still accepted as a fallback.)
INSTAGRAM_APP_SECRET=

# Threads app secret (Threads product settings → "Threads app secret" → Show).
# Threads signs its webhooks with this, NOT the Instagram secret. Leave blank if
# you're not using Threads. 32 hex characters.
THREADS_APP_SECRET=

# A string you invent. Paste the SAME value into the "Verify token" field in the
# Instagram "Configure webhooks" step of the dashboard. Meta echoes it back
# during the GET verification handshake.
# (The legacy name WEBHOOK_VERIFY_TOKEN is still accepted as a fallback.)
WEBHOOK_INSTAGRAM_VERIFY_TOKEN=change-me-to-a-long-random-string

# Optional separate verify token for the Threads "Configure webhooks" step. The
# GET handshake accepts either this or WEBHOOK_INSTAGRAM_VERIFY_TOKEN, so you can
# give Threads its own token or reuse the one above. Leave blank to share.
WEBHOOK_THREADS_VERIFY_TOKEN=

# ── Access tokens (from step 2 "Generate access tokens") ──────────────────────
# Instagram access token for Oleg's account (sends DM replies).
INSTAGRAM_ACCESS_TOKEN=
# Threads access token for Oleg's account.
THREADS_ACCESS_TOKEN=

# Graph API version to call.
GRAPH_API_VERSION=v23.0

# ── Voice notes (ElevenLabs) ──────────────────────────────────────────────────
# Optional. When set, inbound voice DMs are transcribed (Scribe STT) and replies
# are spoken back (TTS). Leave ELEVENLABS_API_KEY blank to disable — voice DMs
# then fall back to a text reply.
ELEVENLABS_API_KEY=
# The ElevenLabs voice id Eve speaks with (Voices → … → "Copy voice ID").
ELEVENLABS_VOICE_ID=
# Optional model overrides.
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
# Public URL of THIS server so Instagram can fetch the spoken reply. Set it to
# your current cloudflared tunnel URL (no trailing slash). Required only for
# outbound voice.
PUBLIC_BASE_URL=

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://pvqrjqwswqbrjxmjcgep.supabase.co
# The privileged, server-only key that bypasses Row Level Security.
# Supabase dashboard → Project Settings → API keys:
#   - new projects: the "Secret key" (sb_secret_...)
#   - older projects: the legacy "service_role" key
# Use the SECRET one, never the publishable/anon key. NEVER ship it to a browser.
SUPABASE_SECRET_KEY=
# (Legacy alias — SUPABASE_SERVICE_ROLE_KEY is still accepted if you prefer it.)
